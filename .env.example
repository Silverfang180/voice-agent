# ==========================================
# Voice Agent Environment Configuration
# ==========================================

# Groq API Key (Used for Whisper STT and Qwen 27B LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3

# LiveKit Cloud Credentials (SIP Phone Agent)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Active TTS Provider: 'edge' (Recommended, zero quota limit), 'gemini', or 'mithi'
TTS_PROVIDER=edge

# Google Gemini API Key (Optional: only needed if TTS_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Mithi Local TTS Microservice URL (Optional: only needed if TTS_PROVIDER=mithi)
MITHI_TTS_URL=http://127.0.0.1:5002

# Server & Agent Configuration
PORT=8000
HOST=0.0.0.0
AGENT_HTTP_PORT=8081
